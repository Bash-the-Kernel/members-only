<!DOCTYPE html>
<html>
<head>
  <title>Create a New Message</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <h1>Create a New Message</h1>
  <% if (errors && errors.length > 0) { %>
    <ul>
      <% errors.forEach(error => { %>
        <li style="color: red;"><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>
  <form action="/create-message" method="POST">
    <div>
      <label for="title">Title:</label>
      <input type="text" id="title" name="title" value="<%= formData.title || '' %>" required>
    </div>
    <div>
      <label for="text">Message:</label>
      <textarea id="text" name="text" required><%= formData.text || '' %></textarea>
    </div>
    <button type="submit">Create Message</button>
  </form>
  <p><a href="/">Back to Home</a></p>
</body>
</html>